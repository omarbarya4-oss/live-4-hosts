# انسخ هذا الملف باسم .env واملأ القيم من لوحة LiveKit
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# اسم الغرفة
ROOM_NAME=main-live

# 4 مفاتيح سرية (واحد لكل مقدم)، مفصولة بفاصلة. المقدم رقم 1 يستخدم المفتاح الأول وهكذا
HOST_KEYS=key-one,key-two,key-three,key-four

PORT=3000
